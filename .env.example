# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored. .env.example is safe to commit (placeholders only).
# No quotes or spaces around the = sign.

# --- Google Gemini (AI Studio) ---
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=API-KEY-HERE
# Pick a model from AI Studio's model list. Flash-Lite tiers usually have
# the highest free limits. Must support structured output + function calling.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_TOKENS_PER_MINUTE=0

# --- Groq (OpenAI-compatible) ---
# Key: https://console.groq.com/keys
GROQ_API_KEY=API-KEY-HERE
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Pick a model from Groq's console that supports structured output + tool calling.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REQUESTS_PER_MINUTE=30
GROQ_TOKENS_PER_MINUTE=8000

# --- Gateway behavior (used in later steps; safe to leave as-is) ---
# Max retry attempts for retryable errors (429, 5xx, timeouts)
LLM_MAX_RETRIES=4
# Per-request timeout in seconds
LLM_TIMEOUT_SECONDS=30
# Cap on simultaneous in-flight requests (keep low on free tiers)
LLM_MAX_CONCURRENCY=3
# Which provider to try first, and whether to fall back to the other
LLM_DEFAULT_PROVIDER=gemini
LLM_ENABLE_FALLBACK=true

# --- Authentication parameters ---
# Comma-separated keys that callers must send in the X-API-Key header
GATEWAY_API_KEYS=your-generated-key-here
# Set to true ONLY for local development without auth
GATEWAY_AUTH_DISABLED=false